# Hostinger (Apache): SPA de React. Vite copia este archivo a dist/.
<IfModule mod_rewrite.c>
  RewriteEngine On
  RewriteBase /

  # Forzar HTTPS
  RewriteCond %{HTTPS} !=on
  RewriteRule ^ https://%{HTTP_HOST}%{REQUEST_URI} [L,R=301]

  # Los bundles faltantes deben responder 404, nunca el index.html de la SPA.
  RewriteRule ^assets/ - [L]

  # Cualquier ruta que no sea un archivo real (/admin, /pos, /?mesa=1) carga la app
  RewriteCond %{REQUEST_FILENAME} !-f
  RewriteCond %{REQUEST_FILENAME} !-d
  RewriteRule ^ /index.html [L]
</IfModule>

<IfModule mod_headers.c>
  Header always set X-Content-Type-Options "nosniff"
  Header always set Referrer-Policy "strict-origin-when-cross-origin"

  # El HTML y el service worker nunca se cachean, para que cada despliegue se vea al instante
  <FilesMatch "(index\.html|sw\.js)$">
    Header set Cache-Control "no-cache, no-store, must-revalidate"
  </FilesMatch>
  # Los archivos de /assets llevan hash en el nombre: se cachean un año
  <If "%{REQUEST_URI} =~ m#^/assets/#">
    Header set Cache-Control "public, max-age=31536000, immutable"
  </If>
</IfModule>
